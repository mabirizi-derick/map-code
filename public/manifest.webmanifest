{
  "id": "/",
  "name": "Kyambogo Digital Campus Map",
  "short_name": "KyambogoMap",
  "description": "Digital campus map and navigation system for Kyambogo University to locate faculties, departments, staff offices, and department heads with interactive routing.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "landscape",
  "background_color": "#ffffff",
  "theme_color": "#0bce3b",
  "lang": "en",
  "dir": "ltr",
  "categories": ["education", "navigation", "travel", "productivity"],
  "icons": [
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-maskable-512x512.png",
